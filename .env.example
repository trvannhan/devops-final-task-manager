# Week 2 (Docker Compose): copy thành file .env cạnh docker-compose.yml.
# Khi deploy bằng GitHub Actions, file .env được tạo tự động từ secret POSTGRES_PASSWORD.
# Chỉ dùng chữ và số cho mật khẩu.
POSTGRES_PASSWORD=CHANGE_ME_LONG_ALPHANUMERIC
# Image cần chạy (mặc định: bản mới nhất trên ghcr.io)
# APP_IMAGE=ghcr.io/trvannhan/devops-final-task-manager:latest

# Week 1 (systemd): file /etc/devops-task-manager.env chứa dòng sau
# DATABASE_URL=postgresql://taskapp:YOUR_PASSWORD@127.0.0.1:5432/taskdb
