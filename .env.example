# File .env cạnh docker-compose.yml (/opt/taskmanager/.env).
# Khi deploy bằng GitHub Actions, file này được tạo tự động từ GitHub Secrets, quyền 600.
# Chỉ dùng chữ và số cho mật khẩu (ví dụ tạo bằng: openssl rand -hex 16).
# Role taskapp (chủ DB, dùng cho backup/restore)
POSTGRES_PASSWORD=CHANGE_ME_OWNER_PASSWORD
# Role taskapp_rw (ứng dụng dùng)
APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD
# Đăng nhập Grafana với user admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
# Image cần chạy (mặc định: bản mới nhất trên ghcr.io)
# APP_IMAGE=ghcr.io/trvannhan/devops-final-task-manager:latest

# Week 1 (systemd): file /etc/devops-task-manager.env chứa dòng sau
# DATABASE_URL=postgresql://taskapp:YOUR_PASSWORD@127.0.0.1:5432/taskdb
